</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>bits</parametername>
</parameternamelist>
<parameterdescription>
<para>the bits to set </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>bitmask</parametername>
</parameternamelist>
<parameterdescription>
<para>the bitmask to apply </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>PROS_SUCCESS if the operation was successful or PROS_ERR if the operation failed, setting errno. </para>
</simplesect>
</para>
