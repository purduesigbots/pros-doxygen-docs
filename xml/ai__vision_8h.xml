<codeline><highlight class="normal">void<sp/>initialize()<sp/>{</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>//<sp/>start<sp/>or<sp/>continue<sp/>looking<sp/>for<sp/>AI<sp/>model<sp/>objects</highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><sp/>aivision_enable_detection_types(AIVISION_PORT,<sp/>aivision_mode_type_e_t::E_AIVISION_MODE_OBJECTS);</highlight></codeline>
<codeline><highlight class="normal">}</highlight></codeline>
</programlisting></para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>port</parametername>
</parameternamelist>
<parameterdescription>
<para>The V5 port number from 1-21 </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>types_mask</parametername>
</parameternamelist>
<parameterdescription>
<para>The types to enable </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>PROS_SUCCESS if the operation was successful or PROS_ERR if the operation failed, setting errno. </para>
</simplesect>
</para>
