<codeline><highlight class="normal"><sp/><sp/><sp/><sp/><ref refid="group__c-link_1ga5dfdea4d57445877ce1ff36560ad7010" kindref="member">link_transmit_raw</ref>(LINK_TRANSMITTER_PORT,<sp/>(</highlight><highlight class="keywordtype">void</highlight><highlight class="normal">*)data,<sp/></highlight><highlight class="keyword">sizeof</highlight><highlight class="normal">(*data)<sp/>*<sp/></highlight><highlight class="keyword">sizeof</highlight><highlight class="normal">(data));</highlight></codeline>
