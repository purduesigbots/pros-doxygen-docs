<codeline><highlight class="normal"><sp/><sp/><ref refid="group__cpp-device_1ggad258d4c51629346fceac4679b3209ad9a59417166c47f7e6b70d1a6701bf4efdd" kindref="member">motor</ref>.set_value(127);<sp/></highlight><highlight class="comment">//<sp/>Go<sp/>full<sp/>speed<sp/>forward</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><sp/><sp/>std::cout<sp/>&lt;&lt;<sp/></highlight><highlight class="stringliteral">&quot;Commanded<sp/>Motor<sp/>Power:<sp/>&quot;</highlight><highlight class="normal"><sp/>&lt;&lt;<sp/><ref refid="group__cpp-device_1ggad258d4c51629346fceac4679b3209ad9a59417166c47f7e6b70d1a6701bf4efdd" kindref="member">motor</ref>.get_value();<sp/></highlight><highlight class="comment">//<sp/>Will<sp/>display<sp/>127</highlight><highlight class="normal"></highlight></codeline>
